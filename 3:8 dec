//DUT
module decoder_3to8(
    input logic [2:0] s,
    output logic [7:0] D
);

assign D[0] = ~s[2] & ~s[1] & ~s[0];
assign D[1] = ~s[2] & ~s[1] &  s[0];
assign D[2] = ~s[2] &  s[1] & ~s[0];
assign D[3] = ~s[2] &  s[1] &  s[0];
assign D[4] =  s[2] & ~s[1] & ~s[0];
assign D[5] =  s[2] & ~s[1] &  s[0];
assign D[6] =  s[2] &  s[1] & ~s[0];
assign D[7] =  s[2] &  s[1] &  s[0];

endmodule


