//dut
module FS(A, B, Bin, D, Bout);

input logic A, B, Bin;
output logic D, Bout;

assign D = A ^ B ^ Bin;

assign Bout = (~A & B) | (~A & Bin) | (B & Bin);

endmodule

//testbench

module FSTB;

logic A, B, Bin, D, Bout, D1, Bout1;

FS n1(A, B, Bin, D, Bout);

initial
begin
    #5 A=0; B=0; Bin=0;
    #5 A=0; B=0; Bin=1;
    #5 A=0; B=1; Bin=0;
    #5 A=0; B=1; Bin=1;
    #5 A=1; B=0; Bin=0;
    #5 A=1; B=0; Bin=1;
    #5 A=1; B=1; Bin=0;
    #5 A=1; B=1; Bin=1;
end

always @(*)
begin
    #1;
    {Bout1, D1} = A - B - Bin;

    if ((D == D1) && (Bout == Bout1))
        $display("Correct");
    else
        $display("Fail");
end

initial
begin
    $dumpfile("dump.vcd");
    $dumpvars(0,FSTB);
    #50 $finish;
end

endmodule

