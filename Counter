
`timescale 1ns/1ps

module counter_10(input clk,rst, output logic [3:0] count);

always @(posedge clk)
begin
    if(rst)
        count <= 0;
    else if(count == 9)
        count <= 0;
    else
        count <= count + 1;

    $display("count=%b",count);
end

endmodule

