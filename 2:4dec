module decTB();

logic [1:0] s;
logic [3:0] D, D1;

decoder_2to4 n1(s,D);

always @(*)
begin
    // Reference model

    if(s == 0)
        D1 = 1;
    else if(s == 1)
        D1 = 2;
    else if(s == 2)
        D1 = 4;
    else if(s == 3)
        D1 = 8;
    else
        D1 = 0;

    // Check

    if(D == D1)
        $display("Success");
    else
        $display("Fail");
end

initial begin
    s = 0;
    for(int i=0; i<4; i++)
    begin
        #5 s = i;
    end
end

