module decoder_2to4(
    input logic [1:0] s,
    output logic [3:0] D
);

assign D[0] = ~s[1] & ~s[0];
assign D[1] = ~s[1] &  s[0];
assign D[2] =  s[1] & ~s[0];
assign D[3] =  s[1] &  s[0];

endmodule

